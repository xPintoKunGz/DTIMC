{
	"schemaVersion": 1,
	"id": "dtimc",
	"version": "${version}",
	"name": "Devathip Interface Mod",
	"description": "A mod to change your Minecraft skin from an in-game menu.",
	"authors": [
		"Bloomery Network Team",
		"xPintoKunG_Z"
	],
	"contact": {
		"homepage": "https://example.com",
		"sources": "https://github.com/xPintoKunGz/DTIMC"
	},
	"license": "MIT",
	"icon": "assets/myskinmod/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [ "bloomery.dtimc.DTIMC" ],
		"client": [ "bloomery.dtimc.DTIMCClient" ],
		"figura_api": [ "bloomery.dtimc.compat.figura.DTIMCFiguraPlugin" ],
		"figura_event": [ "bloomery.dtimc.compat.lipsync.LipSyncEvents" ]
	},
	"mixins": [
		"dtimc.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"fabric-api": "*",
		"minecraft": "~1.20.1",
		"java": ">=17"
	},
	"suggests": {
		"figura": "*",
		"plasmovoice": ">=2.1.17"
	}
}